# 모든 파일은 UTF-8(BOM 없음) + LF. 자세한 규칙은 CLAUDE.md "반드시 지킬 것".
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
